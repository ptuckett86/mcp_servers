from sqlalchemy.orm import Session

from app.models.{{ resource }} import {{ class_name }}
from .schemas import {{ class_name }}Create, {{ class_name }}Update


class {{ class_name }}Service:
    def __init__(self, db: Session):
        self.db = db

    def list(self, skip: int = 0, limit: int = 100) -> list[{{ class_name }}]:
        return self.db.query({{ class_name }}).offset(skip).limit(limit).all()

    def get(self, id: int) -> {{ class_name }} | None:
        return self.db.query({{ class_name }}).filter({{ class_name }}.id == id).first()

    def create(self, payload: {{ class_name }}Create) -> {{ class_name }}:
        item = {{ class_name }}(**payload.model_dump())
        self.db.add(item)
        self.db.commit()
        self.db.refresh(item)
        return item

    def update(self, id: int, payload: {{ class_name }}Update) -> {{ class_name }} | None:
        item = self.get(id)
        if not item:
            return None
        for key, value in payload.model_dump(exclude_unset=True).items():
            setattr(item, key, value)
        self.db.commit()
        self.db.refresh(item)
        return item

    def delete(self, id: int) -> bool:
        item = self.get(id)
        if not item:
            return False
        self.db.delete(item)
        self.db.commit()
        return True
